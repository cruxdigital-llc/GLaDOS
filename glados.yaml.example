# glados.yaml — the one project-owned GLaDOS configuration file.
# Copy to your project's root as `glados.yaml` and edit. Lane-2 keys (channels,
# decisions, merge-authority, params (including the review-panel personas),
# sinks, branching) are read LIVE at run time: editing them changes agent
# behavior on the next run, with no reinstall, and never makes the compile
# stale (`glados.py check` still type-checks their values, so an undeclared
# sink or an unconfessed relaxation fails it). Project workflows (pipelines,
# steps) and canon are live too, except each pipeline's name and description,
# which name a shortcut command. Structural keys (phase, optimize-for,
# default-modules, workflows, disabled-workflows, sda, and those pipeline
# names and descriptions) take effect at `glados.py install`, which stamps a
# hash of them alone into the compiled output; `glados.py check` and
# `glados.py doctor` flag a stale compile when one of them changed. Keys this
# file omits take their defaults from the preset table (.glados/presets.yaml
# after install; in a plugin-only repo, the plugin's own copy). A
# run-pipeline run pins this file, each step body it uses and the
# configuration in effect (this file over that table, as
# `glados.py effective-config` prints it), checks them again before each
# step, before it finishes and on resume, and stops with an escalation if
# one changed: a live edit reaches the next run.

glados: 2

# Which platform the project lives on. The agent uses its own tooling for it
# (glab, gh, MCP); GLaDOS never wires platform APIs itself.
platform: gitlab            # gitlab | github

# REQUIRED — no default. The team states its intent in one word.
# nascent | evolving | production | sunset
# Presets expand into the keys below (precedence: baseline < phase < explicit);
# the assembly report shows the provenance of every resolved value and marks
# phase-derived relaxations loudly.
phase: evolving

# Outcome-type -> sink bindings. An outcome type emitted by an enabled
# workflow with no team-visible sink is an install error unless explicitly
# confessed (visibility-acknowledged); `progress`, `decision`, and
# `observation` may be ledger-only with no confession.
channels:
  progress:    [ledger]
  verdict:     [mr-comment]
  escalation:  [issue]
  bug:         [issue]
  decision:    [ledger]
  observation: [ledger]

# Sinks — where outcomes physically land. Built-in sinks (mr-comment, issue,
# issue-comment, label, ledger) need no declaration. `ledger` is the run
# record, saved to the glados/ledger branch and never to a work branch; it is
# the one built-in that is not team-visible. Declare more here to bind
# them in channels: above; a channels: entry naming an undeclared sink fails the
# install (typo safety). Sink bodies are freeform config the AGENT interprets at
# run time against your platform and conventions — the compiler never parses
# them. A sink you declare here MUST state `team-visible: true` or
# `team-visible: false`; the key is rejected on a built-in, whose visibility is
# fixed. Delivery is verified at run time: a bound sink that fails to receive
# its outcome escalates, whatever the other sinks got, and all of a run's
# delivery failures ride in one escalation that is never itself escalated.
# Exception: an outcome bound to mr-comment before any MR exists is recorded
# under `## Pending MR delivery` and posted by the run that opens the MR (or
# marked not applicable if none ever opens); that is not a failed delivery.
# Examples (uncomment to use):
# sinks:
#   mr-comment:
#     # A verdict comment already has a default shape: see "Publishing a
#     # verdict" in any core that reviews. Configure only what differs for
#     # this project; anything left unsaid keeps the default. These keys
#     # govern wording and order, never whether something is a finding —
#     # that is settled upstream, where it can be recorded. Nor do they
#     # remove the `(GLaDOS <workflow>)` marker every post on a merge
#     # request starts with: review-mr and address-review read an unmarked
#     # note as a person's review.
#     structure: |
#       Breaches that predate the change point at #123, where this
#       project tracks bringing existing code up to standard.
#   slack:
#     team-visible: true        # a sink you declare must say; see above
#     channel: "#code-reviews"  # the agent posts here via its Slack tooling
#     format: terse

# Who may merge. No workflow file states an authority; they all read this key.
merge-authority: human       # human | agent-integration-only | agent

# Decision rights — closed value set: agent | record | escalate | forbidden;
# any other value fails install, check and validate, naming the key (so does
# a merge-authority outside its three). `record` = decide, then emit a
# `decision` outcome. Phase presets fill these; explicit entries override
# (weakening below your phase preset requires relaxation-acknowledged).
decisions:
  schema-migration: record
  public-api-break: record
  new-dependency: agent
  delete-code: agent
  destructive-data-op: escalate
  # pipeline-discretion: record  # picking a pipeline, skipping an optional step

# Confess any explicit key set laxer than the declared phase's preset. Here
# `delete-code: agent` is laxer than evolving's `record`, so it is named below;
# without this line the install fails with a relaxation error. Confessions are
# restated in every assembly report.
relaxation-acknowledged: [delete-code]

# Branch conventions (lane 2 — projects override freely).
branching:
  feature: "feat/<slug>"
  epic-integration: "feature/<epic-slug>"
  default-target: main

# Per-workflow module selection (lane 1 — structural; changes need recompile).
# A workflow absent here installs with default-modules + epilogue. A list must
# include at least the modules the core's `requires:` declares.
default-modules: [standards-gate]
workflows:
  review-mr:      [mr-review-panel]
  verify-feature: [evaluator-spawn]
  fix-bug:        [evaluator-spawn, standards-gate]
  run-epic:       [mr-review-panel, standards-gate]
  brunch:         [mr-review-panel]

# Structurally remove workflows (lane 1 — recompile to apply). Layered like
# the other keys (baseline < phase < explicit): the sunset preset sets
# [build-feature, run-pipeline]; an explicit list here replaces the preset
# list wholesale, so [] re-enables everything a preset disabled (a sunset
# project that keeps an explicit list names both). Disabled cores are not
# installed; their alias shims say so instead of vanishing.
disabled-workflows: []

# Module parameters (lane 2). `review-panel` parameterizes the
# mr-review-panel module; `evaluator` parameterizes evaluator-spawn;
# `standards-gate` bounds the standards gate's re-runs and `pipeline`
# run-pipeline's revise cycles (both default from the preset table). Every
# max-cycles bounds a loop and must be a whole number of 1 or more, written
# plainly (max-cycles: 5): text ("5"), true or false, a list, or 0 or less
# fails install, check and validate, naming the key, and a run that reads
# one escalates instead of starting the loop.
params:
  review-panel:
    personas: [architect]          # added to the standing lenses
    max-cycles: 5
  evaluator:
    max-cycles: 3
  # pipeline:
  #   max-cycles: 8                # revise cycles per pipeline step
  # The level each kind of fresh agent runs at. `session` (the default) uses
  # the session's own model and effort; any other value names a level below.
  # A level maps each runtime you use to that runtime's own words for a model
  # and an effort; GLaDOS names no model, so a renamed one is a change here
  # only. A runtime a level leaves out runs it at `session`. In Claude Code,
  # model is an alias (opus, sonnet, haiku), which follows that tier's newest
  # model, and effort is low, medium, high, xhigh or max.
  # agents:
  #   reviewer: deep               # design reviews and gates
  #   evaluator: deep              # verify-feature and fix-bug's evaluator
  #   panelist: standard           # each review-mr panel seat
  #   refuter: standard            # the refutation stage
  #   levels:
  #     deep:
  #       claude:
  #         model: opus
  #         effort: high
  #     standard:
  #       claude:
  #         model: sonnet
  #         effort: medium

# Project workflows (lane 2, explicit-only: no phase preset sets them). A
# pipeline is an ordered list of steps, GLaDOS's built-in ones (plan-feature,
# shape, spec-feature, implement-feature, verify-feature, open-mr,
# self-review) and the project's own: each declared under steps: with its
# body at product-knowledge/steps/<id>.md (no frontmatter). Order is checked
# only through inputs: a step's needs must come from an earlier step. Run
# one with `/glados:run-pipeline <name> <brief>`; script installs other than
# aistudio also get a shortcut per pipeline (`/glados:<name>`, or
# `/glados-<name>` in Antigravity and pi; in direct mode, a pointer file at
# product-knowledge/glados/<name>.md). Sequences and step options are read
# live; renaming a pipeline or changing its description needs a re-install.
# Check both blocks with `python .glados/glados.py validate --target .` (in
# a plugin-only repo, `bin/glados.py` under the plugin root). See
# docs/guides/pipelines.md. Example (uncomment to use):
# steps:
#   architecture-review:
#     description: Audit structure against our layering and dependency rules
#     kind: gate                   # produce | gate | change
#     stage: speccing              # planning | speccing | implementing | verifying
#     audits: [shape, spec-feature]
# pipelines:
#   backend-feature:
#     description: A change to an endpoint, schema, migration or background job
#     when: >-
#       The change adds or alters an endpoint, a schema, a migration or a
#       background job.
#     sequence:
#       - plan-feature
#       - shape
#       - architecture-review
#       - spec-feature
#       - implement-feature
#       - verify-feature
#       - open-mr
#       - self-review
#     step-options:
#       architecture-review:
#         review: fresh-agent      # none | in-context | fresh-agent
#         checkpoint: none         # none | record | human

# Canon (lane 2, explicit-only: no phase preset sets it): the reference works
# the team holds as authoritative. Each entry names a digest, the team's own
# summary in the repo with one `## <principle-id>` section per principle
# (start from .glados/src/templates/CANON.md, or src/templates/CANON.md
# under the plugin root). Workflows read the digest at their consult points
# and never fetch the url during a run; the steward pass refreshes digests
# from it. A departure from canon is advisory unless
# a `must` standard or `core` philosophy adopts the principle; findings cite
# canon:<name>#<principle-id>. Double-quote `source` (a space then # starts
# a comment). See docs/guides/canon.md. Example (uncomment to use):
# canon:
#   clean-architecture:
#     source: "Robert C. Martin, The Clean Architecture (blog post, 2012)"
#     url: https://blog.cleancoder.com/uncle-bob/2012/08/13/the-clean-architecture.html
#     digest: product-knowledge/canon/clean-architecture.md
#     # Consult points; default [plan-feature, shape, spec-feature,
#     # verify-feature, review-mr]. A list replaces the default: to add
#     # review-codebase, brunch or a step id, list the defaults you keep too.
#     applies-to: [plan-feature, shape, spec-feature, review-mr]
#     seats: [philosophy, architect]  # lenses or personas; replaces [philosophy]

# SDA (Structured Development Artifacts) conformance — EXPLICIT-ONLY, and a
# team declaration: phase presets may never set it. When true, install
# scaffolds the conformance artifacts create-only (claims.md at the project's
# root, product-knowledge/SPEC_LOG.md, `SDA: v1.0` headers on an existing
# ROADMAP.md/PROJECT_STATUS.md, the sda-*.md standards docs into
# product-knowledge/standards/). A run records its claim in claims.md before it
# first mutates shared state, and the outermost run of a unit of work appends
# its work-unit row to SPEC_LOG.md at run end; the row and the claim's release
# are committed with the work on the working branch, and the row links the run
# record on the glados/ledger branch. A run nested inside another, such as
# plan-feature inside build-feature, works under the outer run's claim and row;
# each ticket run-epic builds is a unit of work of its own; review-mr and
# address-review, on another's merge request, add neither; a run parked for a
# person keeps its claim and adds its row when the unit of work ends. See
# docs/guides/sda.md.
sda: false

# Concurrency (later — the lease module, not shipped; today only the base-SHA
# yield rule applies, which is always on and not configurable).
# concurrency:
#   backend: lockfile              # lockfile | issue-claim | none

# Uncomment ONLY to confess a deliberate visibility reduction:
# visibility-acknowledged: ledger-only
